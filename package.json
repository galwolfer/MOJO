{
  "name": "team-mojo-server",
  "version": "2.0.0",
  "description": "MOJO - AI Assistant with Memory & Embeddings",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "test:scheduler": "node scripts/test_scheduler.js",
    "debug:plan": "node scripts/debug_plan.js",
    "test:memory": "node scripts/test_memory.js",
    "test:user-memory": "node scripts/test_user_memory_system.js",
    "test:security": "node scripts/test_security_hardening.js",
    "test:security:integration": "node scripts/test_security_integration.js",
    "migrate:memories": "node scripts/migrate_memories_to_users.js",
    "init:subcategories": "node src/scripts/initialize_general_subcategories.js",
    "test:no-premade-messages": "node scripts/check_no_premade_task_messages.cjs",
    "lint": "echo \"(add ESLint if you want)\"",
    "pytest": "pip install -r requirements.txt && pytest -q",
    "test": "node --test",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "keywords": [
    "ai",
    "assistant",
    "gemini",
    "mongodb",
    "memory",
    "embeddings",
    "semantic-search"
  ],
  "dependencies": {
    "@langchain/core": "^1.0.2",
    "@langchain/google-genai": "^1.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "chrono-node": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo": "^54.0.31",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.0.2",
    "lowdb": "^7.0.1",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-size-matters": "^0.4.2",
    "start": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@types/react": "~19.1.10",
    "babel-jest": "^30.2.0",
    "expo-module-scripts": "^5.0.8",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^8.16.1",
    "nodemon": "^3.1.0",
    "typescript": "~5.9.2"
  }
}
