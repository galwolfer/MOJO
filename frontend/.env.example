# Environment variables for the frontend (Expo)
# Set EXPO_PUBLIC_API_BASE to point the app to your backend when running on a physical device.
# Example: EXPO_PUBLIC_API_BASE=http://192.168.68.102:3000

# EXPO_PUBLIC_API_BASE=http://<YOUR_COMPUTER_LAN_IP>:3000
# Alternatively you can set DEFAULT_MACHINE_IP when starting Expo:
# $env:DEFAULT_MACHINE_IP='192.168.68.102'; npx expo start -c

## Optional: override port
# EXPO_PUBLIC_API_PORT=3000
