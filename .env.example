# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/mojo
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mojo?retryWrites=true&w=majority

# Local machine IP used by Android emulators/devices to reach the dev server
# You can change this to your machine IP, e.g. 192.168.1.12
# DEFAULT_MACHINE_IP=192.168.68.106
DEFAULT_MACHINE_IP=192.168.68.106

# Authentication
# IMPORTANT: Change this secret in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
